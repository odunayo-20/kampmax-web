# This site's own public URL. Used for canonical links, sitemap, and OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL of the authenticated Kampmax application (kampmax-app).
NEXT_PUBLIC_APP_URL=https://app.kampmax.com

# Base URL of the Kampmax API, including the version prefix (API_PREFIX on the
# backend, `api/v1` by default). Local backend: http://localhost:4000/api/v1
# Pages read from it on the server and refresh every few minutes (ISR). The
# backend's CORS_ORIGIN must include this site's URL for browser-side calls
# (the contact form and the article view counter).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Extra hostnames next/image may load remote images from, comma-separated
# (e.g. your S3 / R2 / CDN host). Cloudinary and the API's own host are always
# allowed. Needed when uploaded media is served from another host.
NEXT_PUBLIC_IMAGE_HOSTS=

# MapTiler API key for the campus and event maps. It is public by design (it
# ships to the browser), so restrict it to this site's domains in the MapTiler
# dashboard. Put the real key in .env.local, never in this file. Without a key
# the maps are simply not shown.
NEXT_PUBLIC_MAPTILER_API_KEY=
